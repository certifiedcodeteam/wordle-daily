{
  "name": "PartyRecap",
  "type": "object",
  "properties": {
    "room_id": { "type": "string" },
    "viewer_user_ids": { "type": "array", "items": { "type": "string" } },
    "headline": { "type": "string" },
    "summary": { "type": "string" },
    "mvp": { "type": "string" },
    "coaching_tip": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "ai_generated": { "type": "boolean" }
  },
  "required": ["room_id", "viewer_user_ids", "headline", "summary", "mvp", "coaching_tip", "generated_at", "ai_generated"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "$or": [{ "data.viewer_user_ids": { "$all": ["{{user.id}}"] } }, { "user_condition": { "role": "admin" } }] },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
