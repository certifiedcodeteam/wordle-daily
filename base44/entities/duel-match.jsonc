{
  "name": "DuelMatch",
  "type": "object",
  "properties": {
    "kind": { "type": "string", "enum": ["ranked", "private", "cup"] },
    "status": { "type": "string", "enum": ["waiting", "active", "complete", "cancelled"] },
    "invite_code": { "type": "string" },
    "player_one_id": { "type": "string" },
    "player_two_id": { "type": "string" },
    "winner_user_id": { "type": "string" },
    "session_one_id": { "type": "string" },
    "session_two_id": { "type": "string" },
    "started_at": { "type": "string", "format": "date-time" },
    "deadline": { "type": "string", "format": "date-time" },
    "version": { "type": "integer" },
    "season_id": { "type": "string" },
    "bracket_id": { "type": "string" },
    "setup_status": { "type": "string", "enum": ["pending", "working", "complete"] },
    "settlement_status": { "type": "string", "enum": ["pending", "working", "complete"] }
  },
  "required": ["kind", "status", "player_one_id", "version"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "$or": [{ "data.player_one_id": "{{user.id}}" }, { "data.player_two_id": "{{user.id}}" }, { "user_condition": { "role": "admin" } }] },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
