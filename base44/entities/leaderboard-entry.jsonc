{
  "name": "LeaderboardEntry",
  "type": "object",
  "properties": {
    "season_id": { "type": "string" },
    "user_id": { "type": "string" },
    "handle": { "type": "string" },
    "division": { "type": "string" },
    "cohort": { "type": "integer" },
    "points": { "type": "integer" },
    "wins": { "type": "integer" },
    "rank": { "type": "integer" },
    "updated_at": { "type": "string", "format": "date-time" },
    "applied_operation_keys": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["season_id", "user_id", "handle", "division", "cohort", "points", "wins", "rank", "updated_at"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": true,
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
