{
  "name": "WalletTransaction",
  "type": "object",
  "properties": {
    "user_id": { "type": "string" },
    "operation_key": { "type": "string" },
    "reason": { "type": "string" },
    "delta": { "type": "integer" },
    "xp": { "type": "integer" },
    "resulting_balance": { "type": "integer" },
    "resulting_level": { "type": "integer" },
    "reference_id": { "type": "string" },
    "delivery_status": { "type": "string", "enum": ["pending", "delivering", "complete"] }
  },
  "required": ["user_id", "operation_key", "reason", "delta", "resulting_balance"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "$or": [{ "data.user_id": "{{user.id}}" }, { "user_condition": { "role": "admin" } }] },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
