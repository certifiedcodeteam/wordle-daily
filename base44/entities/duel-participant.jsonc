{
  "name": "DuelParticipant",
  "type": "object",
  "properties": {
    "match_id": { "type": "string" },
    "user_id": { "type": "string" },
    "handle": { "type": "string" },
    "avatar_seed": { "type": "string" },
    "guesses_used": { "type": "integer" },
    "status": { "type": "string", "enum": ["ready", "playing", "won", "lost", "forfeit"] },
    "controller": { "type": "string", "enum": ["human", "bot"] },
    "live_state": { "type": "string", "enum": ["lobby", "ready", "thinking", "typing", "checking", "locked_in", "solved", "finished", "reconnecting"] },
    "persona_key": { "type": "string" },
    "division": { "type": "string" },
    "departed_user_id": { "type": "string" },
    "connection_lost_at": { "type": "string", "format": "date-time" },
    "next_update_at": { "type": "string", "format": "date-time" },
    "elapsed_ms": { "type": "integer" },
    "rating_before": { "type": "integer" },
    "rating_change": { "type": "integer" },
    "reward_xp": { "type": "integer" },
    "reward_tokens": { "type": "integer" },
    "league_points": { "type": "integer" },
    "last_seen_at": { "type": "string", "format": "date-time" },
    "applied_operation_keys": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["match_id", "user_id", "handle", "guesses_used", "status", "rating_before", "rating_change", "last_seen_at"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": true,
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
