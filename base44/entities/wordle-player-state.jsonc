{
  "name": "WordlePlayerState",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner ID for imported legacy records"
    },
    "state_version": {
      "type": "integer",
      "description": "Client state schema version"
    },
    "payload": {
      "type": "object",
      "description": "Merged settings and per-puzzle progress"
    }
  },
  "required": ["state_version", "payload"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "$or": [{ "created_by": "{{user.email}}" }, { "data.user_id": "{{user.id}}" }, { "user_condition": { "role": "admin" } }] },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
