{
  "name": "PartyRoom",
  "type": "object",
  "properties": {
    "invite_code": { "type": "string" },
    "host_user_id": { "type": "string" },
    "member_user_ids": { "type": "array", "items": { "type": "string" } },
    "status": { "type": "string", "enum": ["lobby", "countdown", "active", "between_rounds", "complete", "cancelled"] },
    "demo": { "type": "boolean" },
    "round_number": { "type": "integer" },
    "round_count": { "type": "integer" },
    "countdown_ends_at": { "type": "string", "format": "date-time" },
    "deadline": { "type": "string", "format": "date-time" },
    "transition_ends_at": { "type": "string", "format": "date-time" },
    "version": { "type": "integer" },
    "setup_status": { "type": "string", "enum": ["pending", "working", "complete"] },
    "settlement_status": { "type": "string", "enum": ["pending", "working", "complete"] },
    "recap_status": { "type": "string", "enum": ["pending", "working", "complete", "fallback"] },
    "last_activity_at": { "type": "string", "format": "date-time" },
    "completed_words": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["invite_code", "host_user_id", "member_user_ids", "status", "demo", "round_number", "round_count", "version", "setup_status", "settlement_status", "recap_status", "last_activity_at"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "$or": [{ "data.member_user_ids": { "$all": ["{{user.id}}"] } }, { "user_condition": { "role": "admin" } }] },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
